# SEC EDGAR requires a User-Agent with contact info. Put your name and email here.
SEC_USER_AGENT="Your Name your-email@example.com"

# Alpaca paper trading keys. Get from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
# Paper is the only mode unless this is false AND you run with --live.
ALPACA_PAPER=true
